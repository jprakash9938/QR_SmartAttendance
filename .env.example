# Application
APP_NAME=Dynamic QR Attendance System
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./attendance.db

# Admin Credentials
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=AdminPass123

# JWT Authentication
# IMPORTANT: Generate a strong secret for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# QR Token
QR_TOKEN_EXPIRY_SECONDS=5

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_ATTENDANCE=10/minute
